import pygame
import math
import random

pygame.init()

WIDTH, HEIGHT = 1000, 800
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Hex Road Builder")

WHITE = (240, 240, 240)
BLACK = (20, 20, 20)
GREEN = (50, 150, 80)
BLUE = (50, 100, 200)
RED = (220, 50, 50)
GRAY = (160, 160, 160)
LIGHT_GRAY = (205, 205, 205)   # built but not yet powered
YELLOW = (250, 210, 60)        # powered tile / built city highlight
GOLD = (230, 170, 20)          # power source dot
DARK_RED = (150, 30, 30)       # bin
RIVER_BLUE = (70, 150, 220)
LAKE_BLUE = (35, 90, 165)
FOREST_GREEN = (25, 110, 45)
SAWMILL_BROWN = (120, 70, 20)
STORAGE_PURPLE = (110, 80, 170)

clock = pygame.time.Clock()
FONT = pygame.font.SysFont(None, 28)
SMALL_FONT = pygame.font.SysFont(None, 22)
BIG_FONT = pygame.font.SysFont(None, 54)

HEX_SIZE = 40
COLS = 10
ROWS = 8

# ---------------------------------------------------------------------------
# HEX GEOMETRY
# ---------------------------------------------------------------------------

def hex_points(x, y):
    """Corner points of a flat-top hexagon centered at (x, y)."""
    pts = []
    for i in range(6):
        angle = math.radians(60 * i)
        pts.append((x + HEX_SIZE * math.cos(angle),
                     y + HEX_SIZE * math.sin(angle)))
    return pts


def hex_center(col, row):
    x = 150 + col * HEX_SIZE * 1.5
    y = 150 + row * HEX_SIZE * math.sqrt(3)
    if col % 2:
        y += HEX_SIZE * math.sqrt(3) / 2
    return x, y


def edge_point(cx, cy, edge):
    """Midpoint of the given edge (0-5) of a hex centered at (cx, cy)."""
    a1 = math.radians(60 * edge)
    a2 = math.radians(60 * (edge + 1))
    p1 = (cx + HEX_SIZE * math.cos(a1), cy + HEX_SIZE * math.sin(a1))
    p2 = (cx + HEX_SIZE * math.cos(a2), cy + HEX_SIZE * math.sin(a2))
    return ((p1[0] + p2[0]) / 2, (p1[1] + p2[1]) / 2)


# Offset-coordinate neighbor table for a flat-top "odd-q" hex grid
# (odd columns are shifted down by half a row, matching hex_center above).
NEIGHBOR_OFFSETS = {
    0: {"even": (1, 0),  "odd": (1, 1)},    # lower-right
    1: {"even": (0, 1),  "odd": (0, 1)},    # down
    2: {"even": (-1, 0), "odd": (-1, 1)},   # lower-left
    3: {"even": (-1, -1), "odd": (-1, 0)},  # upper-left
    4: {"even": (0, -1), "odd": (0, -1)},   # up
    5: {"even": (1, -1), "odd": (1, 0)},    # upper-right
}


def neighbor_coords(col, row, edge):
    parity = "odd" if col % 2 else "even"
    dc, dr = NEIGHBOR_OFFSETS[edge][parity]
    return col + dc, row + dr


# ---------------------------------------------------------------------------
# ROAD TOKENS  (5- and 6-armed tiles are forbidden - no budget for them)
# ---------------------------------------------------------------------------

# (shape, weight) - higher weight = more common. Tune these numbers to
# rebalance the deck instead of copy-pasting duplicate entries. Crosses
# are powerful (they connect on 4 sides at once) so they're weighted low;
# straights/curves are the bread-and-butter tile so they're weighted high.
TOKENS = [
    ([0, 3], 5),        # straight
    ([1, 3], 4),        # gentle curve
    ([0, 2], 4),        # gentle curve
    ([1, 2], 3),        # sharp curve
    ([0], 2),           # dead-end cul-de-sac zoning tile
    ([0, 2, 4], 2),     # Y road
    ([0, 1, 3], 2),     # Y road
    ([0, 3, 5], 2),     # Y road
    ([0, 1, 2, 3], 1),  # crossroads (K) - rare, no budget for many
    ([0, 1, 3, 4], 1),  # crossroads (peace) - rare
    ([0, 1, 3, 5], 1),  # crossroads (X) - rare
]
_TOKEN_SHAPES = [shape for shape, _ in TOKENS]
_TOKEN_WEIGHTS = [weight for _, weight in TOKENS]


# random.choices() with weights - still fully random, never cycles, just
# skews the odds toward the cheaper/simpler shapes.
def draw_token():
    return random.choices(_TOKEN_SHAPES, weights=_TOKEN_WEIGHTS, k=1)[0].copy()


def rotate(token):
    return [(x + 1) % 6 for x in token]


# ---------------------------------------------------------------------------
# BOARD CREATION
# ---------------------------------------------------------------------------

board = {}
for c in range(COLS):
    for r in range(ROWS):
        board[(c, r)] = {
            "col": c,
            "row": r,
            "roads": [],
            "city": random.random() < 0.10,
            "is_source": False,
            "powered": False,
            "river": False,
            "river_edges": None,
            "lake": False,
            "special": None,        # "forest" | "sawmill" | None
            "river_charged": False,
        }


def generate_river():
    """Start at a random top-row tile and snake downward, picking a new
    exit edge (2, 3 or 4) at each step, until it flows off the board."""
    start_col = random.randrange(COLS)
    tile = board[(start_col, 0)]
    entry_edge = 4   # symbolically "arrives from off-map, above"
    river_tiles = []
    visited = set()

    while tile is not None and (tile["col"], tile["row"]) not in visited:
        if tile["city"]:
            break  # don't run a river through a city
        exit_edge = random.choice([0, 1, 2])  # the three downward-facing edges
        tile["river"] = True
        tile["river_edges"] = [entry_edge, exit_edge]
        river_tiles.append(tile)
        visited.add((tile["col"], tile["row"]))

        nc, nr = neighbor_coords(tile["col"], tile["row"], exit_edge)
        next_tile = board.get((nc, nr))
        if next_tile is None:
            break  # reached rock bottom (or an edge) - river ends
        entry_edge = (exit_edge + 3) % 6
        tile = next_tile

    return river_tiles


def generate_lakes(river_tiles, max_lakes=4):
    """Scatter up to `max_lakes` lake tiles. Base odds are tiny, but a
    river tile has a decent chance, and the tile right after a river
    tile (in scan order) is likelier too, so lakes cluster near rivers
    or grow into small multi-hex bodies of water."""
    placed = 0
    prev_was_river = False

    for tile in sorted(board.values(), key=lambda t: (t["row"], t["col"])):
        if placed >= max_lakes:
            break
        if tile["city"]:
            prev_was_river = tile["river"]
            continue

        if tile["river"]:
            prob = 0.15
        elif prev_was_river:
            prob = 0.25
        else:
            prob = 0.01

        if random.random() < prob:
            tile["lake"] = True
            placed += 1

        prev_was_river = tile["river"]

    return placed


def generate_forest_and_sawmill():
    """2 forest tiles biased to the left half of the map, 2 sawmill
    tiles biased to the right half."""
    def usable(t):
        return not t["city"] and not t["lake"] and not t["river"]

    left_pool = [t for t in board.values() if usable(t) and t["col"] < COLS // 2]
    right_pool = [t for t in board.values() if usable(t) and t["col"] >= COLS // 2]

    forest_tiles = random.sample(left_pool, min(2, len(left_pool)))
    sawmill_tiles = random.sample(right_pool, min(2, len(right_pool)))

    for t in forest_tiles:
        t["special"] = "forest"
    for t in sawmill_tiles:
        t["special"] = "sawmill"

    return forest_tiles, sawmill_tiles


river_tiles = generate_river()
generate_lakes(river_tiles)
forests, sawmills = generate_forest_and_sawmill()
cities = [tile for tile in board.values() if tile["city"]]

# ---------------------------------------------------------------------------
# GAME STATE
# ---------------------------------------------------------------------------

current_token = draw_token()
storage_token = None
first_tile_placed = False

score = 0
trash_penalty = 0     # -1 per bin use
river_penalty = 0      # -1 per track placed on a river tile
undo_penalty = 0       # -2 per undo
final_bonus = 0        # forest/sawmill bonus minus loose-end penalty, applied once on win

forest_powered_count = 0
sawmill_powered_count = 0

won = False
won_bonus_applied = False

history = []           # stack of placement actions, for UNDO

# ---------------------------------------------------------------------------
# UI LAYOUT
# ---------------------------------------------------------------------------

TOKEN_PREVIEW_CENTER = (850, 150)
TOKEN_PREVIEW_RECT = pygame.Rect(760, 80, 180, 140)

STORAGE_RECT = pygame.Rect(760, 235, 180, 90)
STORAGE_CENTER = (850, 280)
CLEAR_STORAGE_RECT = pygame.Rect(760, 330, 180, 26)

BIN_RECT = pygame.Rect(760, 366, 180, 46)
UNDO_RECT = pygame.Rect(760, 422, 180, 46)


def find_tile(mouse_pos):
    mx, my = mouse_pos
    for tile in board.values():
        cx, cy = hex_center(tile["col"], tile["row"])
        if math.dist((mx, my), (cx, cy)) < HEX_SIZE:
            return tile
    return None


# ---------------------------------------------------------------------------
# NETWORK / SCORING
# ---------------------------------------------------------------------------

def update_power_network():
    """BFS outward from every power-source tile along matching road edges."""
    for tile in board.values():
        tile["powered"] = False

    sources = [t for t in board.values() if t["is_source"]]
    visited = set()
    queue = []

    for s in sources:
        s["powered"] = True
        visited.add((s["col"], s["row"]))
        queue.append(s)

    while queue:
        cur = queue.pop()
        for edge in cur["roads"]:
            nc, nr = neighbor_coords(cur["col"], cur["row"], edge)
            nbr = board.get((nc, nr))
            if nbr is None or (nc, nr) in visited:
                continue
            opposite_edge = (edge + 3) % 6
            if opposite_edge in nbr["roads"]:
                nbr["powered"] = True
                visited.add((nc, nr))
                queue.append(nbr)


def recompute_score():
    global score, forest_powered_count, sawmill_powered_count
    powered_score = 0
    forest_powered_count = 0
    sawmill_powered_count = 0

    for tile in board.values():
        if tile["powered"]:
            powered_score += 1
            if tile["city"]:
                powered_score += 4
            if tile["special"] == "forest":
                forest_powered_count += 1
            elif tile["special"] == "sawmill":
                sawmill_powered_count += 1

    score = powered_score + trash_penalty + river_penalty + undo_penalty + final_bonus


def count_loose_ends():
    """Every road arm that points at an in-bounds tile which does NOT
    connect back is a loose end (-1 each). Arms pointing off the edge
    of the map are fine."""
    loose = 0
    for tile in board.values():
        for edge in tile["roads"]:
            nc, nr = neighbor_coords(tile["col"], tile["row"], edge)
            nbr = board.get((nc, nr))
            if nbr is None:
                continue
            opposite_edge = (edge + 3) % 6
            if opposite_edge not in nbr["roads"]:
                loose += 1
    return loose


def check_win():
    if not cities:
        return False
    return all(city["powered"] for city in cities)


def refresh_win_state():
    """Call after any board-changing action. Applies the one-time
    final bonus/penalty tally the moment all cities become powered,
    and reverses it if that ever stops being true (e.g. after undo)."""
    global won, won_bonus_applied, final_bonus
    won = check_win()

    if won and not won_bonus_applied:
        loose = count_loose_ends()
        bonus = min(forest_powered_count, sawmill_powered_count) * 10
        final_bonus = bonus - loose
        won_bonus_applied = True
        recompute_score()
    elif not won and won_bonus_applied:
        won_bonus_applied = False
        final_bonus = 0
        recompute_score()


# ---------------------------------------------------------------------------
# ACTIONS
# ---------------------------------------------------------------------------

def place_current_token(tile):
    global current_token, first_tile_placed, river_penalty

    entry = {"tile": tile, "was_source": False, "river_charged": False}

    if not first_tile_placed:
        # First placement ever: Y-shaped, unlimited power source.
        tile["roads"] = random.choice([[0, 2, 4], [1, 3, 5]])
        tile["is_source"] = True
        first_tile_placed = True
        entry["was_source"] = True
    else:
        tile["roads"] = current_token.copy()

    if tile["river"]:
        river_penalty -= 1
        tile["river_charged"] = True
        entry["river_charged"] = True

    history.append(entry)

    current_token = draw_token()
    update_power_network()
    recompute_score()
    refresh_win_state()


def trash_current_token():
    global current_token, trash_penalty
    trash_penalty -= 1
    current_token = draw_token()
    recompute_score()


def use_storage():
    global current_token, storage_token
    if storage_token is None:
        storage_token = current_token
        current_token = draw_token()
    else:
        current_token, storage_token = storage_token, current_token


def clear_storage():
    global storage_token
    storage_token = None


def undo_last_placement():
    global first_tile_placed, river_penalty, undo_penalty

    if not history:
        return

    entry = history.pop()
    tile = entry["tile"]
    tile["roads"] = []

    if entry["was_source"]:
        tile["is_source"] = False
        first_tile_placed = False

    if entry["river_charged"]:
        river_penalty += 1
        tile["river_charged"] = False

    undo_penalty -= 2

    update_power_network()
    recompute_score()
    refresh_win_state()


# ---------------------------------------------------------------------------
# DRAWING
# ---------------------------------------------------------------------------

def draw_forest_icon(cx, cy):
    top = cy - 24
    for i, scale in enumerate((1.0, 0.78, 0.56)):
        w, h = 10 * scale, 8 * scale
        ty = top + i * 6
        pygame.draw.polygon(
            screen, FOREST_GREEN,
            [(cx - w, ty + h), (cx + w, ty + h), (cx, ty - h)]
        )


def draw_sawmill_icon(cx, cy):
    center = (cx, cy - 20)
    pygame.draw.circle(screen, SAWMILL_BROWN, center, 9, 2)
    r = 7
    pts = []
    for i in range(3):
        ang = math.radians(-90 + 120 * i)
        pts.append((center[0] + r * math.cos(ang), center[1] + r * math.sin(ang)))
    pygame.draw.polygon(screen, SAWMILL_BROWN, pts, 2)


def draw_tile(tile):
    cx, cy = hex_center(tile["col"], tile["row"])
    corners = hex_points(cx, cy)

    if tile["lake"]:
        fill = LAKE_BLUE
    elif tile["city"]:
        fill = YELLOW if tile["roads"] else GREEN
    elif tile["powered"]:
        fill = YELLOW
    elif tile["roads"]:
        fill = LIGHT_GRAY
    else:
        fill = GRAY

    pygame.draw.polygon(screen, fill, corners)
    pygame.draw.polygon(screen, BLACK, corners, 2)

    if tile["river"] and not tile["lake"]:
        p1 = edge_point(cx, cy, tile["river_edges"][0])
        p2 = edge_point(cx, cy, tile["river_edges"][1])
        pygame.draw.line(screen, RIVER_BLUE, p1, p2, 6)

    for edge in tile["roads"]:
        p = edge_point(cx, cy, edge)
        pygame.draw.line(screen, BLUE, (cx, cy), p, 8)
        pygame.draw.circle(screen, RED, (int(p[0]), int(p[1])), 7)

    if tile["is_source"]:
        pygame.draw.circle(screen, GOLD, (int(cx), int(cy)), 14)
        pygame.draw.circle(screen, BLACK, (int(cx), int(cy)), 14, 2)
    elif tile["roads"]:
        pygame.draw.circle(screen, BLUE, (int(cx), int(cy)), 6)

    if tile["special"] == "forest":
        draw_forest_icon(cx, cy)
    elif tile["special"] == "sawmill":
        draw_sawmill_icon(cx, cy)


def draw_mini_hex(center, roads, ring_color=GRAY):
    pygame.draw.circle(screen, ring_color, center, HEX_SIZE - 4)
    for e in roads:
        p = edge_point(center[0], center[1], e)
        pygame.draw.line(screen, BLUE, center, p, 7)


def draw_token_preview():
    pygame.draw.rect(screen, WHITE, TOKEN_PREVIEW_RECT)
    pygame.draw.rect(screen, BLACK, TOKEN_PREVIEW_RECT, 2)
    label = FONT.render("Next tile", True, BLACK)
    screen.blit(label, (TOKEN_PREVIEW_RECT.x + 20, TOKEN_PREVIEW_RECT.y + 6))
    draw_mini_hex(TOKEN_PREVIEW_CENTER, current_token)


def draw_storage():
    pygame.draw.rect(screen, WHITE, STORAGE_RECT)
    pygame.draw.rect(screen, STORAGE_PURPLE, STORAGE_RECT, 3)
    label = FONT.render("Storage (click to swap)", True, BLACK)
    screen.blit(label, (STORAGE_RECT.x + 6, STORAGE_RECT.y + 4))

    if storage_token is None:
        empty = SMALL_FONT.render("empty", True, GRAY)
        rect = empty.get_rect(center=(STORAGE_CENTER[0], STORAGE_CENTER[1] + 10))
        screen.blit(empty, rect)
    else:
        draw_mini_hex(STORAGE_CENTER, storage_token, ring_color=LIGHT_GRAY)

    pygame.draw.rect(screen, DARK_RED, CLEAR_STORAGE_RECT, border_radius=6)
    clear_label = SMALL_FONT.render("Clear storage (free)", True, WHITE)
    rect = clear_label.get_rect(center=CLEAR_STORAGE_RECT.center)
    screen.blit(clear_label, rect)


def draw_bin():
    pygame.draw.rect(screen, DARK_RED, BIN_RECT, border_radius=8)
    pygame.draw.rect(screen, BLACK, BIN_RECT, 2, border_radius=8)
    label = FONT.render("Trash tile (-1)", True, WHITE)
    rect = label.get_rect(center=BIN_RECT.center)
    screen.blit(label, rect)


def draw_undo_button():
    active = len(history) > 0
    color = DARK_RED if active else GRAY
    pygame.draw.rect(screen, color, UNDO_RECT, border_radius=8)
    pygame.draw.rect(screen, BLACK, UNDO_RECT, 2, border_radius=8)
    label = FONT.render("Undo last (-2)", True, WHITE)
    rect = label.get_rect(center=UNDO_RECT.center)
    screen.blit(label, rect)


def draw_hud():
    y = UNDO_RECT.bottom + 14
    lines = [
        f"Score: {score}",
        f"Cities powered: {sum(1 for c in cities if c['powered'])}/{len(cities)}",
        f"Forest/Sawmill: {forest_powered_count}/{sawmill_powered_count}",
    ]
    for line in lines:
        screen.blit(FONT.render(line, True, BLACK), (760, y))
        y += 28

    y += 6
    for line in ("R: rotate", "Click tile: place", "Click bin: trash",
                 "Click storage: swap/save"):
        screen.blit(SMALL_FONT.render(line, True, BLACK), (760, y))
        y += 22

    if not first_tile_placed:
        hint = SMALL_FONT.render("First placement = power source!", True, DARK_RED)
        screen.blit(hint, (760, y + 4))


def draw():
    screen.fill(WHITE)

    for tile in board.values():
        draw_tile(tile)

    draw_token_preview()
    draw_storage()
    draw_bin()
    draw_undo_button()
    draw_hud()

    if won:
        text = BIG_FONT.render("ALL CITIES CONNECTED & POWERED!", True, (20, 120, 20))
        screen.blit(text, (40, 20))
        breakdown = FONT.render(
            f"Final score: {score}  (forest/sawmill bonus + loose-end penalty applied)",
            True, (20, 120, 20)
        )
        screen.blit(breakdown, (40, 70))

    pygame.display.flip()


# ---------------------------------------------------------------------------
# GAME LOOP
# ---------------------------------------------------------------------------

running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        elif event.type == pygame.KEYDOWN:
            if event.key == pygame.K_r:
                current_token = rotate(current_token)

        elif event.type == pygame.MOUSEBUTTONDOWN:
            pos = event.pos

            if UNDO_RECT.collidepoint(pos):
                undo_last_placement()
            elif BIN_RECT.collidepoint(pos):
                trash_current_token()
            elif CLEAR_STORAGE_RECT.collidepoint(pos):
                clear_storage()
            elif STORAGE_RECT.collidepoint(pos):
                use_storage()
            else:
                tile = find_tile(pos)
                if tile and not tile["roads"] and not tile["lake"]:
                    place_current_token(tile)

    draw()
    clock.tick(60)

pygame.quit()
